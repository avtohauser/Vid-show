<Window x:Class="VidShow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vid-show" Width="1060" Height="740" MinWidth="800" MinHeight="660"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Segoe UI Symbol" AllowDrop="True" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized" Closed="Window_Closed">
    <Window.Resources>
        <DataTemplate x:Key="ItemTpl">
            <DockPanel>
                <TextBlock Text="{Binding DurText}" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding Badge}" DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentLightBrush}"/>
                <TextBlock x:Name="Ico" Text="•" Width="20" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Ico" Property="Text" Value="▶"/>
                    <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ: пульт -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,1,7,0"/>
                        <TextBlock x:Name="StatusText" Text="Проектор выключен" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FileName" Text="Vid-show" FontSize="17" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>

            <!-- Превью -->
            <Border Grid.Row="1" Background="Black" CornerRadius="12" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Rectangle x:Name="PrevA"/>
                    <Rectangle x:Name="PrevB"/>
                    <StackPanel x:Name="Hint" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎬" FontSize="44" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock x:Name="HintText" Text="Перетащите видео и картинки сюда" FontSize="16" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,8,0,2"/>
                        <TextBlock x:Name="HintSub" Text="или нажмите «＋ Добавить» справа" FontSize="12.5" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <Border x:Name="BlackBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="10" Background="#CC000000" BorderBrush="#FF5C7A" BorderThickness="1"
                            CornerRadius="6" Padding="8,3">
                        <TextBlock Text="⬛ ПРОЕКТОР ЧЁРНЫЙ" FontSize="11" FontWeight="SemiBold" Foreground="#FF8DA1"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Таймлайн -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="54"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurTime" Text="00:00" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"/>
                <Border x:Name="Film" Grid.Column="1" Height="58" CornerRadius="8" Background="#161922"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" Cursor="Hand" Margin="4,0"
                        SizeChanged="Film_SizeChanged" MouseLeftButtonDown="Film_MouseDown" MouseMove="Film_MouseMove"
                        MouseLeftButtonUp="Film_MouseUp" MouseLeave="Film_MouseLeave">
                    <Grid x:Name="FilmArea" Background="Transparent">
                        <UniformGrid x:Name="Tiles" Rows="1" IsHitTestVisible="False"/>
                        <Rectangle x:Name="TrimL" Fill="#B8250A18" HorizontalAlignment="Left" Width="0" IsHitTestVisible="False"/>
                        <Rectangle x:Name="TrimR" Fill="#B8250A18" HorizontalAlignment="Right" Width="0" IsHitTestVisible="False"/>
                        <Rectangle x:Name="FilmDim" Fill="#A6000000" HorizontalAlignment="Right" Width="0" IsHitTestVisible="False"/>
                        <Rectangle x:Name="FilmHead" Width="3" Fill="White" HorizontalAlignment="Left" IsHitTestVisible="False"
                                   RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
                        <Border x:Name="HoverTip" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,4,0,0" Background="#E6000000" CornerRadius="4" Padding="6,1" IsHitTestVisible="False">
                            <TextBlock x:Name="HoverText" FontFamily="Consolas" FontSize="11.5"/>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock x:Name="RemTime" Grid.Column="2" Text="−00:00" VerticalAlignment="Center" TextAlignment="Right"
                           FontFamily="Consolas" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
            </Grid>

            <!-- Управление -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="LoopChk" Style="{StaticResource Chip}" Content="🔁 Повтор" Margin="0,0,6,0"
                                  Click="Loop_Click" ToolTip="Повторять текущее видео (L)"/>
                    <Button x:Name="SpeedBtn" Content="1×" Padding="11,6" FontSize="12.5" MinWidth="46"
                            Click="Speed_Click" ToolTip="Скорость воспроизведения"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="⏮" Click="Prev_Click" ToolTip="Предыдущее (P)"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource RoundButton}" Content="▶" Margin="4,0"
                            Click="PlayPause_Click" ToolTip="Старт / пауза (Пробел)"/>
                    <Button Style="{StaticResource GhostButton}" Content="⏭" Click="Next_Click" ToolTip="Следующее (N)"/>
                    <Button Style="{StaticResource GhostButton}" Content="■" Click="Stop_Click" ToolTip="Стоп (S)"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="PreviewChk" Style="{StaticResource Chip}" Content="👁 Превью" IsChecked="True" Margin="0,0,6,0"
                                  Click="PreviewChk_Click" ToolTip="Выключите превью, если компьютер слабый"/>
                    <ToggleButton x:Name="MuteChk" Style="{StaticResource Chip}" Content="🔇" Margin="0,0,8,0"
                                  Click="Mute_Click" ToolTip="Без звука (M)"/>
                    <Slider x:Name="VolSlider" Width="92" Minimum="0" Maximum="1" Value="0.8"
                            IsMoveToPointEnabled="True" ValueChanged="Vol_ValueChanged" ToolTip="Громкость"/>
                </StackPanel>
            </Grid>

            <!-- Очередь: переходы -->
            <Border Grid.Row="4" Margin="0,14,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12,10">
                <DockPanel>
                    <TextBlock Text="ОЧЕРЕДЬ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Переход" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="FadeBtn" Content="1 с" Padding="11,5" FontSize="12.5" MinWidth="64" Margin="0,0,16,0"
                                Click="Fade_Click" ToolTip="Длительность плавного перехода между элементами очереди"/>
                        <TextBlock Text="Таймер картинки" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="ImgBtn" Content="10 с" Padding="11,5" FontSize="12.5" MinWidth="64"
                                Click="ImgSecs_Click" ToolTip="Сколько секунд показывать картинку, у которой не включено «∞ Ждать»"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Проектор -->
            <Border Grid.Row="5" Margin="0,10,0,0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="BlackChk" Style="{StaticResource Chip}" Content="⬛ Чёрный экран" Margin="0,0,8,0"
                                      Padding="12,8" Click="Black_Click" ToolTip="Мгновенно погасить проектор, видео идёт дальше (B)"/>
                        <Button x:Name="ProjBtn" Style="{StaticResource AccentButton}" Content="Показать на проекторе"
                                Click="Proj_Click" ToolTip="Включить / выключить вывод на проектор (F)"/>
                    </StackPanel>
                    <TextBlock Text="ПРОЕКТОР" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <Button x:Name="ScreenBtn" Content="Экран 2" HorizontalAlignment="Left" Click="Screen_Click"
                            ToolTip="Нажмите, чтобы выбрать другой монитор"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ПРАВАЯ ЧАСТЬ: очередь видео и фоновая музыка -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Мини-плеер музыки: виден на любой вкладке -->
                <Border Grid.Row="0" Background="{StaticResource Surface2Brush}" CornerRadius="9" Padding="4">
                    <DockPanel>
                        <Button x:Name="MiniPlay" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="▶"
                                Padding="9,3" FontSize="14" Click="MusicPlayPause_Click" ToolTip="Музыка: пуск / пауза (K)"/>
                        <TextBlock x:Name="MiniTitle" Text="♪ Музыка не выбрана" VerticalAlignment="Center" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" Margin="2,0,8,0"/>
                    </DockPanel>
                </Border>

                <UniformGrid Grid.Row="1" Rows="1" Margin="0,10,0,10">
                    <ToggleButton x:Name="TabVideo" Style="{StaticResource Chip}" Content="🎬 Видео" IsChecked="True"
                                  Margin="0,0,3,0" Click="TabVideo_Click"/>
                    <ToggleButton x:Name="TabMusic" Style="{StaticResource Chip}" Content="🎵 Музыка"
                                  Margin="3,0,0,0" Click="TabMusic_Click"/>
                </UniformGrid>

                <!-- Вкладка: видео и картинки -->
                <Grid x:Name="VideoTab" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Очистить" Padding="10,5" FontSize="12" Click="Clear_Click"/>
                        <Button DockPanel.Dock="Right" Content="＋ Добавить" Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                Style="{StaticResource AccentButton}" Click="Add_Click"/>
                        <TextBlock Text="ОЧЕРЕДЬ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="PlayList" Grid.Row="1" ItemTemplate="{StaticResource ItemTpl}"
                             MouseDoubleClick="PlayList_DoubleClick" SelectionChanged="PlayList_SelectionChanged"/>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <DockPanel>
                            <ToggleButton x:Name="HoldChk" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="⏸ Ждать" IsEnabled="False"
                                          Click="Hold_Click" ToolTip="Ждать оператора: картинка/чёрный висят, а видео после конца остаётся на последнем кадре, пока вы не включите следующее (Пробел или N)"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▲" Padding="9,5" Margin="0,0,3,0" Click="Up_Click" ToolTip="Выше в очереди"/>
                                <Button Content="▼" Padding="9,5" Margin="0,0,3,0" Click="Down_Click" ToolTip="Ниже в очереди"/>
                                <Button Content="✕" Padding="9,5" Margin="0,0,3,0" Click="Remove_Click" ToolTip="Убрать из очереди (Del)"/>
                                <Button Content="⚙" Padding="9,5" Margin="0,0,3,0" Click="Edit_Click" ToolTip="Свойства: обрезка, повторы, переходы, фанфара, музыка (E)"/>
                                <Button Content="⬛" Padding="9,5" Click="AddBlack_Click" ToolTip="Вставить чёрный экран / паузу после выбранного"/>
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid Rows="1" Margin="0,6,0,0">
                            <Button Content="📂 Открыть" Padding="6,5" FontSize="12" Margin="0,0,3,0" Click="OpenProject_Click" ToolTip="Открыть программу из файла"/>
                            <Button Content="💾 Сохранить" Padding="6,5" FontSize="12" Margin="3,0,3,0" Click="SaveProject_Click" ToolTip="Сохранить программу в файл"/>
                            <Button Content="🗓 План" Padding="6,5" FontSize="12" Margin="3,0,0,0" Click="Program_Click" ToolTip="План мероприятия: все элементы по порядку, паузы, повторы, переходы (G)"/>
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" LineHeight="17" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Пробел — пуск/пауза (на картинке ожидания — включить следующее) · B — чёрный экран · F — проектор · M — звук видео · K — музыка · Ctrl+↑/↓ — громкость музыки · L — повтор · ←/→ — ±5 с (Shift — ±30 с) · N/P — следующее/предыдущее · Del — убрать · Esc — скрыть проектор"/>
                </Grid>

                <!-- Вкладка: фоновая музыка -->
                <Grid x:Name="MusicTab" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Очистить" Padding="10,5" FontSize="12" Click="MusicClear_Click"/>
                        <Button DockPanel.Dock="Right" Content="＋ Музыка" Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                Style="{StaticResource AccentButton}" Click="MusicAdd_Click"/>
                        <TextBlock Text="ФОН" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="MusicList" Grid.Row="1" ItemTemplate="{StaticResource ItemTpl}"
                             MouseDoubleClick="MusicList_DoubleClick"/>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MCur" Text="00:00" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                        <Slider x:Name="MPos" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                                ValueChanged="MPos_ValueChanged"/>
                        <TextBlock x:Name="MTot" Grid.Column="2" Text="00:00" FontFamily="Consolas" FontSize="11.5"
                                   TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="⏮" Click="MusicPrev_Click" ToolTip="Предыдущий трек"/>
                        <Button x:Name="MusicPlayBtn" Style="{StaticResource AccentButton}" Content="▶" FontSize="16" Width="50"
                                Click="MusicPlayPause_Click" Margin="4,0" ToolTip="Пуск / пауза (K)"/>
                        <Button Style="{StaticResource GhostButton}" Content="⏭" Click="MusicNext_Click" ToolTip="Следующий трек"/>
                        <Button Style="{StaticResource GhostButton}" Content="■" Click="MusicStop_Click" ToolTip="Стоп"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="4" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <Button x:Name="MusicLoopBtn" Content="🔁 Список" Padding="10,5" FontSize="12" Margin="0,0,5,5"
                                Click="MusicLoop_Click" ToolTip="Что делать, когда трек закончился: играть список по кругу / зациклить один трек / остановиться"/>
                        <ToggleButton x:Name="MusicShuffleChk" Style="{StaticResource Chip}" Content="🔀" Margin="0,0,5,5"
                                      Click="MusicShuffle_Click" ToolTip="Случайный порядок"/>
                        <ToggleButton x:Name="DuckChk" Style="{StaticResource Chip}" Content="🔉 Приглушать" Margin="0,0,5,5" IsChecked="True"
                                      Click="Duck_Click" ToolTip="Автоматически делать музыку тише, пока идёт видео со звуком"/>
                    </WrapPanel>

                    <StackPanel Grid.Row="5" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="MusicVol" Minimum="0" Maximum="1" Value="0.7" IsMoveToPointEnabled="True"
                                    ValueChanged="MusicVol_ValueChanged" ToolTip="Громкость музыки (Ctrl+↑/↓)"/>
                        </DockPanel>
                        <UniformGrid Rows="1" Margin="0,6,0,0">
                            <Button Content="⤴ Плавно вкл" Padding="8,5" FontSize="12" Margin="0,0,3,0" Click="MusicFadeIn_Click"
                                    ToolTip="Музыка плавно нарастает"/>
                            <Button Content="⤵ Плавно выкл" Padding="8,5" FontSize="12" Margin="3,0,0,0" Click="MusicFadeOut_Click"
                                    ToolTip="Музыка плавно затихает и ставится на паузу (3 с)"/>
                        </UniformGrid>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="⚙" Padding="9,5" Margin="4,0,0,0" Click="WinSound_Click"
                                    ToolTip="Звук Windows: выбрать устройство для звука видео (Параметры → Громкость → приложение)"/>
                            <Button x:Name="DeviceBtn" Content="🔈 Устройство по умолчанию" Padding="9,5" FontSize="12" Click="Device_Click"
                                    ToolTip="Куда выводить музыку и фанфары. Нажимайте, чтобы переключать устройства. Звук видео идёт на устройство Windows по умолчанию (кнопка ⚙)"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Margin="0,10,0,0">
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Стоп" Padding="8,3" FontSize="11" Margin="3,0,0,0" Click="PadsStop_Click"
                                    ToolTip="Остановить все играющие эффекты"/>
                            <Button DockPanel.Dock="Right" Content="Сброс" Padding="8,3" FontSize="11" Click="PadsClear_Click"
                                    ToolTip="Очистить все кнопки"/>
                            <TextBlock Text="ФАНФАРЫ И ЭФФЕКТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid x:Name="PadGrid" Columns="3"/>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="🎺" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="SfxVol" Minimum="0" Maximum="1" Value="0.9" IsMoveToPointEnabled="True"
                                    ValueChanged="SfxVol_ValueChanged" ToolTip="Громкость эффектов"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
