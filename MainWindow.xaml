<Window x:Class="VidShow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vid-show — пульт" Width="900" Height="620" MinWidth="560" MinHeight="420"
        Background="#1e1e1e" Foreground="White" AllowDrop="True"
        Drop="Window_Drop" KeyDown="Window_KeyDown" Closed="Window_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Открыть видео…" Padding="12,4" Click="Open_Click" DockPanel.Dock="Left"/>
            <TextBlock x:Name="FileName" Margin="10,0,0,0" VerticalAlignment="Center"
                       Text="Файл не выбран (можно перетащить сюда)" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Border Grid.Row="1" Background="Black" BorderBrush="#444" BorderThickness="1">
            <Rectangle x:Name="PreviewRect"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CurTime" Text="00:00" VerticalAlignment="Center" Width="60"/>
            <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                    VerticalAlignment="Center" ValueChanged="Timeline_ValueChanged"/>
            <TextBlock x:Name="TotTime" Grid.Column="2" Text="00:00" VerticalAlignment="Center"
                       Width="60" TextAlignment="Right"/>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button x:Name="PlayBtn" Content="▶ Старт" Width="90" Padding="0,6" Margin="0,0,6,0" Click="PlayPause_Click"/>
            <Button Content="■ Стоп" Width="70" Padding="0,6" Margin="0,0,16,0" Click="Stop_Click"/>
            <CheckBox x:Name="LoopChk" Content="Повтор" VerticalAlignment="Center" Foreground="White" Margin="0,0,16,0"/>
            <TextBlock Text="Громкость" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider x:Name="VolSlider" Width="90" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center"
                    ValueChanged="Vol_ValueChanged" Margin="0,0,16,0"/>
            <TextBlock Text="Проектор:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ScreenBox" Width="190" Margin="0,0,6,0" SelectionChanged="ScreenBox_SelectionChanged"/>
            <Button x:Name="ProjBtn" Content="Показать на проекторе" Padding="12,6" Click="Proj_Click"/>
        </WrapPanel>
    </Grid>
</Window>
