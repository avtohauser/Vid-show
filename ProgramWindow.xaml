<Window x:Class="VidShow.ProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="План мероприятия" Width="1100" Height="400" MinWidth="640" MinHeight="300"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Segoe UI Symbol" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized" Closed="Window_Closed">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="⚙ Свойства" Padding="12,7" Click="Edit_Click" ToolTip="Свойства выбранного элемента (E)"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Масштаб" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Slider x:Name="Zoom" Width="130" Minimum="2" Maximum="30" Value="8" IsMoveToPointEnabled="True" ValueChanged="Zoom_ValueChanged"/>
            </StackPanel>
            <TextBlock Text="ПЛАН МЕРОПРИЯТИЯ" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Strip" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,8"/>
        </ScrollViewer>

        <TextBlock x:Name="Summary" Grid.Row="2" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
