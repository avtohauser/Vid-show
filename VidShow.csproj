<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8: встроен в Windows 10/11, ставится на Windows 7/8; exe весит ~100 КБ -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VidShow</AssemblyName>
    <RootNamespace>VidShow</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Vid-show</Product>
    <Description>Двухэкранный видеоплеер: пульт + проектор</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- NAudio: вывод музыки/эффектов на выбранное устройство и бесшовное зацикливание -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Costura: вшивает все библиотеки внутрь exe — по-прежнему один файл -->
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
